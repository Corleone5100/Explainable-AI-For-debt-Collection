# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=debt_market_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Graph Builder Settings
GRAPH_NODE_LIMIT=200000
GNN_EPOCHS=100
GNN_LR=0.005
GNN_HIDDEN=32
GNN_HEADS=4
GNN_DROPOUT=0.3

# RL Training Settings
RL_LEARNING_RATE=0.0003
RL_N_STEPS=2048
RL_TOTAL_TIMESTEPS=500000
RL_DEVICE=cuda

# Evaluation Settings
EVAL_TRAIN_RATIO=0.8
EVAL_N_EPISODES=50
EVAL_N_SEEDS=3
EVAL_ABLATION_FEATURES=graph,structural,community,multihop

# Feature Set Configuration
# Options: optimal (recommended), full, ablation
#   optimal  = +all_graph (16 features: core + community + 1-hop + GAT embeddings)
#   full     = all 150 features (requires 5M timesteps, auto-scaled)
#   ablation = run all feature subsets for analysis
FEATURE_SET=optimal

# Training Duration
# For optimal feature set: 500000 (default, auto-scaled for full)
# For full feature set:    5000000 (10x more needed if FEATURE_SET=full)

# Curriculum Learning (gradual risk category exposure)
# true  = Start with High/Very High, gradually add Medium/Low/Very Low
# false = All risk categories from the start
CURRICULUM_LEARNING=true

# Visualization Settings
VIZ_SAMPLE_SIZE=100

# ⚠️  IMPORTANT: Copy this file to .env and fill in your actual values.
#    Never commit .env to version control.
#    Add ".env" to your .gitignore file.
